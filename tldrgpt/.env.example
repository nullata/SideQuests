SOURCE_DATA=example-data
DELETED_DATA=deleted-data

# Analysis backend: "codex" (local Codex CLI) or "openai" (any OpenAI-compatible API)
ANALYSIS_BACKEND=codex

# --- Codex CLI backend ---
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.2-codex
CODEX_TIMEOUT_SECONDS=600

# --- OpenAI-compatible backend (local AI) ---
# Set ANALYSIS_BACKEND=openai to use this. Works with any OpenAI-compatible
# /chat/completions endpoint. Example base URLs:
#   Ollama:    http://localhost:11434/v1
#   LM Studio: http://localhost:1234/v1
#   LlamaMan:  http://localhost:42069/v1   (https://github.com/nullata/llamaman)
OPENAI_BASE_URL=http://localhost:11434/v1
# Leave blank for servers that don't require auth (Ollama, LM Studio).
# For LlamaMan with require_auth on, set the bearer token here.
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1
OPENAI_TIMEOUT_SECONDS=600

FLASK_DEBUG=1
